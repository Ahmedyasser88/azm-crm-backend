# Copy to Docker/.env and fill in real values before running `docker compose up`.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=5100

POSTGRES_HOST=postgres
POSTGRES_DB=AzmCrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_SSL_MODE=Prefer

JWT_SECRET=CHANGE_ME_SuperSecretKeyForJWT_MinimumLength32Chars!
JWT_ISSUER=AzmCrm
JWT_AUDIENCE=AzmCrm
JWT_EXPIRY_MINUTES=120

CORS_ALLOWED_ORIGIN=http://localhost:3100
